# ====================================
# Backend Environment Variables
# ====================================
# 이 파일을 복사해서 `.env`로 이름을 바꾼 뒤 실제 값을 채우세요.
# .env 파일은 .gitignore에 등록되어 GitHub에 올라가지 않습니다.


# === Database ===
# PostgreSQL 연결 URL
# 형식: postgresql+<드라이버>://<사용자>:<비밀번호>@<호스트>:<포트>/<DB명>
# 비동기 작업용 (FastAPI 엔드포인트에서 사용)
DATABASE_URL=postgresql+asyncpg://postgres:your_password@localhost:5432/cooksync

# 동기 작업용 (Alembic 마이그레이션에서 사용)
ALEMBIC_DATABASE_URL=postgresql+psycopg2://postgres:your_password@localhost:5432/cooksync


# === External API Keys ===
# YouTube Data API v3 - 영상 검색용
# 발급: https://console.cloud.google.com → API 및 서비스 → 사용자 인증 정보
YOUTUBE_API_KEY=your_youtube_data_api_v3_key

# Google Gemini API - 자막을 단계별로 분류
# 발급: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key


# === AI Inference Server ===
# 학교 GPU 서버에서 실행되는 추론 서버 주소
# 로컬 mock 서버를 띄울 경우 http://localhost:8001 사용
AI_SERVER_URL=http://localhost:8001


# === Application Settings ===
# 개발 모드 여부 (True면 상세 에러 메시지 표시)
DEBUG=True

# CORS 허용 출처 (프론트엔드 dev 서버 주소)
# Vite 기본 포트 5173
CORS_ORIGINS=http://localhost:5173